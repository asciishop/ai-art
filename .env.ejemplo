# ============================================================
#  Configuración de la plataforma
# ============================================================
#  Copia este fichero a  .env  y rellena lo que necesites:
#
#      cp .env.ejemplo .env
#
#  El backend lo lee al arrancar. Lo que ya esté en el entorno (un `export`
#  previo) MANDA sobre lo que ponga aquí, así que el pod puede sobreescribir
#  sin editar el fichero.
#
#  ⚠️  .env está en .gitignore. NO lo quites de ahí: contiene claves.
# ============================================================


# --- El motor de los personajes (vLLM en el pod) -------------------------
# Esto NO se toca para usar OpenRouter. La voz de los guardianes son sus LoRA,
# y los LoRA solo existen en tu vLLM.
VLLM_URL=http://localhost:8000/v1/chat/completions
# Solo si arrancaste vLLM con --api-key:
#VLLM_API_KEY=
MODELO_BASE=Qwen/Qwen3-8B


# --- Modelo externo para lo ANALÍTICO (opcional) -------------------------
# Destilar el recuerdo es un juicio, no una interpretación: "resume esto en una
# frase, o di NADA si es trivial". Ahí un modelo grande acierta más, y como
# ocurre DESPUÉS de que el visitante ya escuchó la respuesta, su latencia no se
# nota en la sala.
#
# Descomenta las tres para enviar SOLO esa parte a OpenRouter.
# Deja esto vacío y todo sigue funcionando contra el vLLM del pod, como hoy.
#
# Coste orientativo con ling-3.0-flash y ~100 conversaciones al día:
# unos 2 céntimos diarios. Verifica el precio actual antes de comprometerte.
#
#MEMORIA_URL=https://openrouter.ai/api/v1/chat/completions
#MEMORIA_API_KEY=sk-or-v1-PON_AQUI_TU_CLAVE
#MEMORIA_MODELO=inclusionai/ling-3.0-flash

# OpenRouter usa estas dos para identificar la app (opcionales):
#APP_URL=https://github.com/asciishop/ai-art
#APP_NOMBRE=Guardianes


# --- Memoria que escribe --------------------------------------------------
# RECORDAR=0 apaga por completo el archivo y la destilación.
#RECORDAR=1


# --- Filtro del RAG -------------------------------------------------------
# Distancia máxima para que un fragmento entre en el prompt, margen respecto al
# mejor, y cuántos se consultan. Se ven en vivo en el modo 🔬 Rayos X.
#RAG_UMBRAL=0.55
#RAG_MARGEN=0.18
#RAG_K=3


# --- Voz ------------------------------------------------------------------
# La síntesis corre en el pod (Piper + efectos). Los diales por personaje
# (voz_modelo, voz_androide, voz_lejania) están en personajes.yaml, no aquí.
# Si faltan piper-tts o pedalboard, la web cae sola a la voz del navegador.
