@startuml plataforma-despliegue
title Plataforma de personajes artificiales - Despliegue (texto en OpenRouter)

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam nodesep 16
skinparam ranksep 26
skinparam ArrowFontSize 11

' ============================================================
'  1. LA SALA — un solo equipo, sin GPU
' ============================================================
node "SALA (instalacion fisica)" as SALA #FDF6E3 {

  actor "visitante" as USER

  node "EQUIPO DE SALA (portatil normal, SIN GPU)" as KIOSCO #E8F5E9 {

    node "Webcam" as CAM
    node "Microfono" as MIC
    node "Altavoz" as SPK

    node "Navegador: Chrome o Edge\nen http://localhost:3000" as NAV #E3F2FD {
      component "index.html\nchat + rayos X + cola de audio" as WEB
      component "presencia.js\nmovimiento en los bordes -> reclamo\ncercania + giro de cabeza -> conversar" as PRES
      artifact  "vendor/\nMediaPipe WASM 9 MB\nface_landmarker.task 3,7 MB" as MODELCV
      component "Web Speech API\ndictado + vigia de la orden ""para""\nsintesis: solo de RESERVA" as SPEECH
    }

    node "uvicorn :3000" as UVI {
      component "backend/main.py\nFastAPI: orquesta el turno" as BACK
      component "backend/memoria.py\nla memoria que escribe" as MEMO
      component "backend/voz.py\nPiper + pedalboard (CPU)" as VOZ
      component "tools/registro.py" as REGC
      artifact  "web/ servido como estatico" as WEBSRV
    }

    component "tools/ingest.py\n(se corre UNA vez, antes de abrir)" as INGEST #FFF3CD

    node "Disco" as DISCO {
      artifact  ".env\nCLAVE de OpenRouter + que modelos usar" as ENV #FFEBEE
      artifact  "personajes.yaml\nREGISTRO CENTRAL\n+ diales de voz por personaje" as YAML
      artifact  "personajes/*/system_prompt.md\nAHORA sostiene el personaje EL SOLO" as SYSP
      artifact  "voces/*.onnx\nmodelos Piper (se bajan solos)" as VOCES
      database  "vector_store/chroma.sqlite3\ncanon: *_mem\nvivido: *_exp" as CHROMA
      database  "vector_store/archivo.db\nSQLite: intercambios crudos" as SQLITE
      artifact  "personajes/*/adapter/\nLoRA entrenados - SIN USAR" as LORAS #EEEEEE
    }
  }
}

' ============================================================
'  2. FUERA — lo unico que ya no es local
' ============================================================
cloud "OpenRouter\nAPI compatible OpenAI" as OR #E1F5FE {
  component "CHAT de los 3 personajes\nnemotron-3.5-lightning:free  (30B/3B)\n-> laguna-s-2.1:free  (118B/8B)\n-> ling-3.0-tiny:free  (7,9B/1,3B)" as ORCHAT
  component "MEMORIA: destilar el recuerdo\nlfm-2.5-2.6b:free\n-> ling-3.0-tiny:free" as ORMEM
}

cloud "Reconocimiento de voz\ndel navegador (Google)" as STT #FFEBEE

' ============================================================
'  Preparacion: una sola vez
' ============================================================
INGEST ..> CHROMA : ""--todos --reset""\nindexa el canon
ENV ..> BACK      : clave y modelos\n(se lee al arrancar)

' ============================================================
'  Runtime
' ============================================================
USER --> CAM : pasa de largo,\nse acerca, gira la cabeza
USER --> MIC : habla, o dice ""para""
SPK --> USER : poemas y respuestas\nen voz alta

CAM --> PRES     : MediaStream\n(no sale del navegador)
PRES --> MODELCV : carga WASM + modelo
PRES --> WEB     : borde -> poema al azar\ncerca -> saluda y abre el micro\ngiro -> cambia de guardian
WEB --> SPEECH   : escuchar() / vigilar()
MIC --> SPEECH
SPEECH ..> STT   : HTTPS: audio del visitante
WEB --> SPK      : reproduce el WAV,\nfrase a frase

NAV --> WEBSRV : http://localhost:3000\nGET /  ·  /web/*  ·  /api/*
WEB --> BACK   : POST /api/chat -> SSE\nPOST /api/voz  -> WAV

BACK --> REGC   : que coleccion, prompt\ny diales de voz
REGC --> YAML
REGC --> SYSP
BACK --> CHROMA : RAG: canon + vivido
BACK --> VOZ    : una frase cada vez
VOZ --> VOCES   : carga el modelo Piper\ndel personaje

BACK ..> ORCHAT : HTTPS\nmodels[] = cadena de reserva\nreasoning: effort none
BACK --> MEMO   : al cerrar el turno\n(salvo el poema: recordar=false)
MEMO --> SQLITE : archiva el intercambio crudo
MEMO ..> ORMEM  : destila el recuerdo
MEMO --> CHROMA : guarda el recuerdo en *_exp

note bottom of NAV
  Ya no hace falta el proxy HTTPS de
  RunPod: 'localhost' cuenta como
  origen seguro, asi que la camara y
  el microfono funcionan tal cual.
end note

note right of LORAS
  Los 3 adaptadores entrenados
  ya NO intervienen: OpenRouter
  no sabe nada de ellos. Con
  ellos se fue la capa "Voz /
  estilo", que ahora sostiene
  solo el system_prompt.md.

  No se borran: si algun dia
  vuelve un vLLM, siguen validos.
end note

note bottom of OR
  Lo UNICO que ya no corre en la sala.
  Dos cadenas de modelos gratuitos: si
  el primero devuelve 429 -los ':free'
  comparten capacidad- se prueba el
  siguiente sin que el visitante lo note.

  Limite: 50 peticiones/dia, o 1.000 si
  se han comprado $10 alguna vez.
  Cada turno gasta 2 (chat + memoria).
end note

note bottom of VOZ
  Sigue siendo LOCAL y en CPU. Es lo que
  obliga a tener un equipo en la sala
  aunque el texto venga de fuera: la voz
  del navegador no se puede procesar.
end note

@enduml
